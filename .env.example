# Backend manzili. ⚠️ Oxirida `/` QO'YILMAYDI — `${BASE}/auth/login`
# shaklida qo'shiladi va ikkita slash 404 beradi.
# Backend API manzili.
#   Ishlab chiqishda: http://localhost:3000/api/v1
VITE_API_URL=https://issiqlik-api.yaxshihayot.uz/api/v1

# WebSocket (jonli yangilanish) manzili — backend bilan AYNI host.
# Jonli yangilanish (WebSocket) manzili - API bilan AYNI host.
# ⚠️ Boshqa host yozilsa, CORS to‘sadi va holat o‘zgarishi ekranda
#    ko‘rinmay qoladi (sahifa esa xatosiz ishlaydi - sabab bilinmaydi).
VITE_SOCKET_URL=https://issiqlik-api.yaxshihayot.uz

# ───────── FON XARITASI (tayl manbasi) ─────────
# ⚠️ BO'SH qoldirilsa — OpenStreetMap ishlatiladi: BEPUL, API kalit
# va bank kartasi KERAK EMAS. Ko'pchilik uchun shu yetarli.
#
# ⚠️ Leaflet'ning O'ZIDA xarita YO'Q — u faqat render qiladi va
# taylarni tashqi serverdan oladi. Shuning uchun bu yerdagi manzil
# «qaysi xaritani ko'ramiz» degan savolni hal qiladi.
#
# Boshqa xizmatga o'tish (MapTiler, Carto, Stadia) — faqat shu ikki
# qatorni to'ldiring, kodga tegish shart emas:
#   VITE_BASEMAP_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=KALIT
#   VITE_BASEMAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap hissadorlari
#
# ⚠️ Xato manzil qo'yilsa, tayl serveri xato MATNINI rasm sifatida
# qaytarib, xaritani suv belgilari bilan to'ldiradi — manzilni
# brauzerda bir marta ochib tekshiring.
VITE_BASEMAP_URL=
VITE_BASEMAP_ATTRIBUTION=
